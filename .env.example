# Copy this file to .env and fill in real values. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-with-a-new-random-key
# Comma-separated. Required in production; development falls back to localhost.
ALLOWED_HOSTS=localhost,127.0.0.1
# Dummy value. No feature uses it yet; kept so API keys live in .env, not code.
API_KEY=dummy-api-key
# Optional, development only. Point runserver/admin at a disposable SQLite file
# (ignored by Git) instead of the committed demo db.sqlite3. Leave unset normally.
# DATABASE_NAME=db.local.sqlite3
# Google sign-in. Create an OAuth client (type: Web application) in the Google
# Cloud Console, add http://127.0.0.1:8000/accounts/google/login/callback/ as an
# authorized redirect URI, and paste the values here in .env. Leave them blank
# and the site still runs; the login page says Google sign-in is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production only. The deployed site must send Google an https callback; this is
# the default. Set it to http only to try production mode over plain http locally.
# ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
# A6 local AI ("Explain with AI" on a violation). No key needed: the model is
# public and transformers downloads it (~3.4 GB) the first time it is used.
# On by default in development, off by default in production.
# AI_LOCAL_ENABLED=true
# AI_LOCAL_MODEL_ID=HuggingFaceTB/SmolLM2-1.7B-Instruct
# auto = GPU if available, else CPU (CPU needs about 7 GB of free RAM).
# AI_LOCAL_DEVICE=auto
# A9 handbook Q&A (/handbook/). It answers with the local model above, so it is
# off wherever AI_LOCAL_ENABLED is off. Until RAG_EMBEDDING_MODEL_ID is set the
# page says the handbook is not configured. A9 was evaluated with the
# RAG_EMBEDDING_MODEL_ID, RAG_CHUNKING, RAG_TOP_K and RAG_MIN_SCORE values shown
# below. A8 recommends sentence-transformers/all-mpnet-base-v2, not yet evaluated
# in A9. The model downloads on the first question.
# RAG_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# Folder of .md files, relative to the repository root. The handbook is in
# rag_system/knowledge_base (the default); rag_system/sample_kb holds two small
# sample files.
# RAG_KB_DIR=rag_system/knowledge_base
# cpu (default) leaves the GPU to the local model; or cuda.
# RAG_EMBEDDING_DEVICE=cpu
# A8 chunking strategy: fixed, overlap or hybrid (default).
# RAG_CHUNKING=hybrid
# RAG_TOP_K=3
# Passages scoring below this are not sent to the model. The code default is 0.3;
# A8 found no cutoff that separates answerable from out-of-scope questions, so the
# A9 evaluation used -1 (keep every passage).
# RAG_MIN_SCORE=-1
# Leave RAG_QUERY_PREFIX unset to use the prefix A8 gave the model; setting it,
# even to an empty value, overrides that.
# A6 external API ("Explain with Groq"). Free key at https://console.groq.com/keys.
# Leave blank and the button says the API is not available; nothing is sent.
# Sends the dataset, column, rule and row counts. Values from the file go only
# when they are known status codes like AUDIT (at most 3) or NOT_NULL blanks;
# numbers, names, emails, IDs and other text from the file are never sent.
# Answers are cached for an hour.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# A10 analytics cost settings (optional; defaults shown).
# ANALYTICS_GPU_WATTS=355
# ANALYTICS_KWH_PRICE=0.15
